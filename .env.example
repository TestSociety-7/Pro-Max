# ---- Database -------------------------------------------------------------
# Local development: a SQLite file is created automatically. Leave as-is.
DATABASE_URL=file:./data/promax.db
# Production (e.g. Vercel): use a hosted libSQL database such as Turso.
#   DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-token
DATABASE_AUTH_TOKEN=

# ---- Admin sign-in --------------------------------------------------------
# Generate with:  npm run hash-password
# Paste the full single-line output (starts with "scrypt:").
ADMIN_PASSWORD_HASH=

# Random secret that signs the admin session cookie. At least 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
